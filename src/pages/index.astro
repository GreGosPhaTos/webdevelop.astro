---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout
  title="Développeur Web : Adrien Petitjean - webdevelop.fr"
  description="Adrien Petitjean développeur web, webdevelop.fr"
  keywords="Adrien Petitjean, développeur web, PHP, SQL, nodeJs, JavaScript, AJAX, web"
  lang="fr"
>
  <Navigation />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-blobs">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>
    <div class="container hero-container">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="text-gradient">ADRIEN</span>
          <span class="text-outline">PETITJEAN</span>
        </h1>
        <div class="hero-subtitle">Staff Developer</div>
        <p class="hero-tagline">
          Architecte de solutions web durables et performantes.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">Voir mes projets</a>
          <a href="#contact" class="btn">Me contacter</a>
        </div>
      </div>
    </div>
    <div class="scroll-indicator">
      <div class="mouse"></div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <h2 class="section-title">Parcours & Vision</h2>
          <div class="about-text">
            <p>
              👋 Je suis <span class="text-highlight">Adrien</span>, un
              architecte logiciel passionné par la création d'expériences web
              exceptionnelles. Actuellement Staff Developer chez <a
                href="https://www.lightspeedhq.com/"
                target="_blank"
                rel="noopener">Lightspeed</a
              >.
            </p>
            <p>
              Depuis 2008, j'ai navigué à travers l'évolution du web, relevant
              des défis techniques chez des leaders comme <a
                href="https://unity.com/"
                target="_blank"
                rel="noopener">Unity</a
              > et <a
                href="https://www.shutterstock.com/"
                target="_blank"
                rel="noopener">Shutterstock</a
              >.
            </p>
            <p>
              Ma philosophie repose sur trois piliers : la <strong
                >performance</strong
              > brute, l'<strong>éco-conception</strong> et une <strong
                >expérience utilisateur</strong
              > sans compromis.
            </p>
          </div>
          <div class="about-actions">
            <a
              href="https://www.linkedin.com/in/adrien-petitjean-10916255"
              target="_blank"
              class="btn">Mon LinkedIn →</a
            >
          </div>
        </div>
        <div class="about-stats">
          <div class="stat-card">
            <span class="stat-value">15+</span>
            <span class="stat-label">Années d'Expérience</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">100%</span>
            <span class="stat-label">Passion Code</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="projects" id="projects">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Projets Sélectionnés</h2>
        <p class="section-tagline">
          Une sélection de réalisations techniques alliant performance et
          innovation.
        </p>
      </div>

      <div class="projects-grid">
        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Writing</span>
            <h3 class="project-title">Articles Medium</h3>
            <p class="project-description">
              Réflexions et tutoriels sur le développement web moderne et
              l'architecture.
            </p>
            <a
              href="https://medium.com/@adrien.petitjean84"
              target="_blank"
              class="project-link">Lire la suite →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Infrastructure</span>
            <h3 class="project-title">AWS Lambda TS</h3>
            <p class="project-description">
              Un template optimisé pour le déploiement de Lambdas AWS en
              TypeScript.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/typescript-lambda"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card featured">
          <div class="project-content">
            <span class="project-category">Performance</span>
            <h3 class="project-title">Bigfile</h3>
            <p class="project-description">
              Outil CLI ultra-rapide pour identifier les fichiers volumineux sur
              votre système.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/bigfile"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Desktop App</span>
            <h3 class="project-title">Zippy</h3>
            <p class="project-description">
              Un archiveur de fichiers simple et élégant conçu avec Electron JS.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/zippy"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">E-commerce</span>
            <h3 class="project-title">Emma Roussel</h3>
            <p class="project-description">
              Site web professionnel pour une naturopathe, optimisé pour le SEO.
            </p>
            <a
              href="https://emma-roussel-naturopathe.com/"
              target="_blank"
              class="project-link">Voir le site →</a
            >
          </div>
        </div>
      </div>

      <!-- Projects footer removed -->
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-card">
        <div class="contact-header">
          <h2 class="section-title">Restons connectés</h2>
          <p class="contact-tagline">
            Retrouvez-moi sur les différentes plateformes ou par email.
          </p>
        </div>
        <div class="contact-methods">
          <a
            href="mailto:adrien.petitjean84@gmail.com"
            class="contact-email-btn"
          >
            <span class="email-icon">✉</span>
            adrien.petitjean84@gmail.com
          </a>
          <div class="social-links-new">
            <a
              href="https://github.com/GreGosPhaTos"
              target="_blank"
              class="social-btn">GitHub</a
            >
            <a
              href="https://www.linkedin.com/in/adrien-petitjean-10916255"
              target="_blank"
              class="social-btn">LinkedIn</a
            >
            <a
              href="https://medium.com/@adrien.petitjean84"
              target="_blank"
              class="social-btn">Medium</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <p>&copy; 2026 Adrien Petitjean - WebDevelop</p>
        <p class="footer-note">Site éco-conçu • ~15KB • ~0.01g CO₂</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Variables and base styles are in Layout.astro */

  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-top: 8rem;
    overflow: hidden;
  }

  .hero-blobs {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    width: 40vw;
    height: 40vw;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: blobFloat 20s infinite alternate;
  }

  .blob-1 {
    background: var(--color-accent);
    top: -10%;
    left: -10%;
  }

  .blob-2 {
    background: #ec4899; /* Pink accent */
    bottom: -10%;
    right: -10%;
    animation-delay: -5s;
  }

  @keyframes blobFloat {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(10%, -5%) scale(1.1);
    }
    66% {
      transform: translate(-5%, 15%) scale(0.9);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }

  .hero-content {
    text-align: center;
    z-index: 1;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--color-surface-glass);
    border: var(--glass-border);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    backdrop-filter: blur(var(--glass-blur));
    animation: fadeInUp 1s ease-out;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-subtitle {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--color-surface-glass);
    border: var(--glass-border);
    border-radius: 100px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    backdrop-filter: blur(var(--glass-blur));
    animation: fadeInUp 1s ease-out 0.5s both;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .text-gradient {
    background: linear-gradient(
      135deg,
      var(--color-text-primary) 30%,
      var(--color-accent) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .text-outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-tertiary);
    opacity: 0.5;
    animation: fadeInUp 1s ease-out 0.4s both;
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-xl);
    animation: fadeInUp 1s ease-out 0.6s both;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-xl); /* Increased gap to avoid scroll indicator overlap */
    justify-content: center;
    animation: fadeInUp 1s ease-out 0.8s both;
    margin-bottom: var(--space-2xl);
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: fadeIn 2s ease-in;
  }

  .mouse {
    width: 26px;
    height: 42px;
    border: 2px solid var(--color-text-tertiary);
    border-radius: 20px;
    position: relative;
  }

  .mouse::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 2px;
    animation: mouseScroll 2s infinite;
  }

  @keyframes mouseScroll {
    0% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 15px);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* About Section */
  .about {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }

  .about-content {
    max-width: 700px;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .about-content h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-lg);
    font-weight: 400;
  }

  .about-content p {
    margin-bottom: var(--space-md);
    line-height: 1.8;
  }

  .about-content a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .about-content a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  /* Projects Section */
  .projects {
    padding: var(--space-2xl) 0;
    position: relative;
    scroll-margin-top: 6rem;
  }

  .section-header {
    margin-bottom: var(--space-2xl);
    max-width: 600px;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-sm);
  }

  .section-tagline {
    color: var(--color-text-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .project-card {
    background: var(--color-surface-glass);
    border: var(--glass-border);
    backdrop-filter: blur(var(--glass-blur));
    border-radius: 24px;
    padding: var(--space-xl);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .project-card.featured {
    grid-column: span 2;
    background: linear-gradient(
      135deg,
      var(--color-surface-glass) 0%,
      rgba(99, 102, 241, 0.1) 100%
    );
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-accent);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .project-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    display: block;
  }

  .project-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .project-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
  }

  .project-link {
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap var(--transition-fast);
  }

  .project-link:hover {
    gap: 0.75rem;
    color: var(--color-accent);
  }

  .projects-footer {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--color-text-tertiary);
  }

  .projects-footer a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }

  @media (max-width: 768px) {
    .project-card.featured {
      grid-column: span 1;
    }
  }

  /* About Section */
  .about {
    padding: var(--space-2xl) 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: var(--space-2xl);
    align-items: start;
  }

  .about-text p {
    margin-bottom: var(--space-lg);
    font-size: 1.25rem;
    text-align: justify;
  }

  .text-highlight {
    color: var(--color-accent);
    font-weight: 500;
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .stat-card {
    background: var(--color-surface-glass);
    border: var(--glass-border);
    padding: var(--space-xl);
    border-radius: 20px;
    text-align: center;
    backdrop-filter: blur(var(--glass-blur));
  }

  .stat-value {
    display: block;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
    font-family: var(--font-serif);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Contact Section */
  .contact {
    padding: var(--space-2xl) 0;
    scroll-margin-top: 6rem;
  }

  .contact-card {
    background: linear-gradient(
      135deg,
      var(--color-surface-glass) 0%,
      rgba(99, 102, 241, 0.05) 100%
    );
    border: var(--glass-border);
    border-radius: 40px;
    padding: var(--space-2xl);
    text-align: center;
    backdrop-filter: blur(var(--glass-blur));
  }

  .contact-methods {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .contact-email-btn {
    font-size: clamp(1.25rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: color var(--transition-base);
  }

  .contact-email-btn:hover {
    color: var(--color-accent);
  }

  .social-links-new {
    display: flex;
    gap: var(--space-md);
  }

  .social-btn {
    padding: 0.75rem 1.5rem;
    border: var(--glass-border);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-base);
  }

  .social-btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-stats {
      flex-direction: row;
    }

    .stat-card {
      flex: 1;
    }
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: var(--space-xl);
    }

    .social-links-new {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
