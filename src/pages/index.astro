---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout
  title="Développeur Web : Adrien Petitjean - webdevelop.fr"
  description="Adrien Petitjean développeur web, webdevelop.fr"
  keywords="Adrien Petitjean, développeur web, PHP, SQL, nodeJs, JavaScript, AJAX, web"
  lang="fr"
>
  <Navigation />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-blobs">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge">Staff Developer</div>
        <h1 class="hero-title">
          <span class="text-gradient">ADRIEN</span>
          <span class="text-outline">PETITJEAN</span>
        </h1>
        <p class="hero-tagline">
          Architecte de solutions web durables et performantes.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">Voir mes projets</a>
          <a href="#contact" class="btn">Me contacter</a>
        </div>
      </div>
    </div>
    <div class="scroll-indicator">
      <div class="mouse"></div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-content">
        <h3>À propos de moi</h3>
        <p>
          👋 Je m'appelle Adrien, et je suis Staff Developer chez <a
            href="https://www.lightspeedhq.com/"
            target="_blank"
            rel="noopener">Lightspeed</a
          >.
        </p>
        <p>J'ai commencé mon parcours dans le web en 2008.</p>
        <p>
          Au cours de ma carrière, j'ai eu l'opportunité de relever des défis
          techniques complexes au sein d'entreprises de renom telles que <a
            href="https://unity.com/"
            target="_blank"
            rel="noopener">Unity Technologies</a
          > et <a
            href="https://www.shutterstock.com/"
            target="_blank"
            rel="noopener">Shutterstock</a
          >.
        </p>
        <p>
          Passionné par tous les aspects du développement web, je m'efforce de
          concevoir des architectures performantes tout en continuant d'explorer
          de nouveaux horizons technologiques.
        </p>
        <p>
          Pour en savoir plus sur mon parcours : <a
            href="https://www.linkedin.com/in/adrien-petitjean-10916255"
            target="_blank"
            rel="noopener">mon profil LinkedIn.</a
          >
        </p>
        <p>
          Je serais ravi d'échanger avec vous sur des sujets techniques (ou
          non), alors n'hésitez pas à <a href="#contact">me contacter</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="projects" id="projects">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Projets Sélectionnés</h2>
        <p class="section-tagline">
          Une sélection de réalisations techniques alliant performance et
          innovation.
        </p>
      </div>

      <div class="projects-grid">
        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Writing</span>
            <h3 class="project-title">Articles Medium</h3>
            <p class="project-description">
              Réflexions et tutoriels sur le développement web moderne et
              l'architecture.
            </p>
            <a
              href="https://medium.com/@adrien.petitjean84"
              target="_blank"
              class="project-link">Lire la suite →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Infrastructure</span>
            <h3 class="project-title">AWS Lambda TS</h3>
            <p class="project-description">
              Un template optimisé pour le déploiement de Lambdas AWS en
              TypeScript.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/typescript-lambda"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card featured">
          <div class="project-content">
            <span class="project-category">Performance</span>
            <h3 class="project-title">Bigfile</h3>
            <p class="project-description">
              Outil CLI ultra-rapide pour identifier les fichiers volumineux sur
              votre système.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/bigfile"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">Desktop App</span>
            <h3 class="project-title">Zippy</h3>
            <p class="project-description">
              Un archiveur de fichiers simple et élégant conçu avec Electron JS.
            </p>
            <a
              href="https://github.com/GreGosPhaTos/zippy"
              target="_blank"
              class="project-link">GitHub →</a
            >
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-category">E-commerce</span>
            <h3 class="project-title">Emma Roussel</h3>
            <p class="project-description">
              Site web professionnel pour une naturopathe, optimisé pour le SEO.
            </p>
            <a
              href="https://emma-roussel-naturopathe.com/"
              target="_blank"
              class="project-link">Voir le site →</a
            >
          </div>
        </div>
      </div>

      <div class="projects-footer">
        <p>
          Découvrez plus de projets sur mon <a
            href="https://github.com/GreGosPhaTos"
            target="_blank">GitHub</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-content">
        <h3>Contact</h3>
        <p class="contact-tagline">Ensemble décrochons la lune !</p>
        <p class="contact-email">
          Contactez moi <a href="mailto:adrien.petitjean84@gmail.com"
            >adrien.petitjean84@gmail.com</a
          >
        </p>
        <div class="social-links">
          <a
            href="https://github.com/GreGosPhaTos"
            target="_blank"
            rel="noopener"
            title="GitHub"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/adrien-petitjean-10916255"
            target="_blank"
            rel="noopener"
            title="LinkedIn"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href="https://medium.com/@adrien.petitjean84"
            target="_blank"
            rel="noopener"
            title="Medium"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42S14.2 15.54 14.2 12s1.51-6.42 3.38-6.42S20.96 8.46 20.96 12zm3.04 0c0 3.03-.47 5.48-1.05 5.48S21.9 15.03 21.9 12s.47-5.48 1.05-5.48S24 8.97 24 12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <p>&copy; 2026 Adrien Petitjean - WebDevelop</p>
        <p class="footer-note">Site éco-conçu • ~15KB • ~0.01g CO₂</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Variables and base styles are in Layout.astro */

  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-top: 8rem;
    overflow: hidden;
  }

  .hero-blobs {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    width: 40vw;
    height: 40vw;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: blobFloat 20s infinite alternate;
  }

  .blob-1 {
    background: var(--color-accent);
    top: -10%;
    left: -10%;
  }

  .blob-2 {
    background: #ec4899; /* Pink accent */
    bottom: -10%;
    right: -10%;
    animation-delay: -5s;
  }

  @keyframes blobFloat {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(10%, -5%) scale(1.1);
    }
    66% {
      transform: translate(-5%, 15%) scale(0.9);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }

  .hero-content {
    text-align: center;
    z-index: 1;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--color-surface-glass);
    border: var(--glass-border);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    backdrop-filter: blur(var(--glass-blur));
    animation: fadeInUp 1s ease-out;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .text-gradient {
    background: linear-gradient(
      135deg,
      var(--color-text-primary) 30%,
      var(--color-accent) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .text-outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-tertiary);
    opacity: 0.5;
    animation: fadeInUp 1s ease-out 0.4s both;
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-xl);
    animation: fadeInUp 1s ease-out 0.6s both;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    animation: fadeInUp 1s ease-out 0.8s both;
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: fadeIn 2s ease-in;
  }

  .mouse {
    width: 26px;
    height: 42px;
    border: 2px solid var(--color-text-tertiary);
    border-radius: 20px;
    position: relative;
  }

  .mouse::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 2px;
    animation: mouseScroll 2s infinite;
  }

  @keyframes mouseScroll {
    0% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 15px);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* About Section */
  .about {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .about-content {
    max-width: 700px;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .about-content h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-lg);
    font-weight: 400;
  }

  .about-content p {
    margin-bottom: var(--space-md);
    line-height: 1.8;
  }

  .about-content a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .about-content a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  /* Projects Section */
  .projects {
    padding: var(--space-2xl) 0;
    position: relative;
  }

  .section-header {
    margin-bottom: var(--space-2xl);
    max-width: 600px;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-sm);
  }

  .section-tagline {
    color: var(--color-text-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .project-card {
    background: var(--color-surface-glass);
    border: var(--glass-border);
    backdrop-filter: blur(var(--glass-blur));
    border-radius: 24px;
    padding: var(--space-xl);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300px;
  }

  .project-card.featured {
    grid-column: span 2;
    background: linear-gradient(
      135deg,
      var(--color-surface-glass) 0%,
      rgba(99, 102, 241, 0.1) 100%
    );
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-accent);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .project-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    display: block;
  }

  .project-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .project-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
  }

  .project-link {
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap var(--transition-fast);
  }

  .project-link:hover {
    gap: 0.75rem;
    color: var(--color-accent);
  }

  .projects-footer {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--color-text-tertiary);
  }

  .projects-footer a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }

  @media (max-width: 768px) {
    .project-card.featured {
      grid-column: span 1;
    }
  }

  /* Contact Section */
  .contact {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .contact-content {
    max-width: 600px;
  }

  .contact-content h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-md);
    font-weight: 400;
  }

  .contact-tagline {
    font-size: 1.25rem;
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .contact-email {
    margin-bottom: var(--space-xl);
  }

  .contact-email a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .contact-email a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  .social-links {
    display: flex;
    gap: var(--space-lg);
  }

  .social-links a {
    color: var(--color-text-secondary);
    transition:
      color var(--transition-base),
      transform var(--transition-base);
    display: inline-block;
  }

  .social-links a:hover {
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  /* Footer */
  .footer {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-content p {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }

  .footer-note {
    font-size: 0.75rem !important;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding-top: 4rem;
      min-height: 90vh;
    }

    .footer-content {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
