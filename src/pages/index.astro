---
import { getEntry, getCollection } from 'astro:content';
import HomeTemplate from '../components/HomeTemplate.astro';

const entry = await getEntry('homepage', 'fr');
const articles = await getCollection('blog', ({ data, slug }) => {
  return data.draft !== true && slug.startsWith('fr/');
});

articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

if (!entry) {
  throw new Error('Blog Post non trouvé');
}

const { data: content } = entry;
---

<HomeTemplate content={content} lang="fr" articles={articles} />
