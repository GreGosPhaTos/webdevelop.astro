---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.slug.startsWith('fr/'))
    .map((post) => ({
      params: { slug: post.slug.replace('fr/', '') },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} | Adrien Petitjean`}
  description={post.data.description}
  lang="fr"
>
  <Navigation lang="fr" frHref="/blog" enHref="/en/blog" />

  <article class="post-container">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <span class="separator">•</span>
        <span class="post-author">{post.data.author}</span>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-tags">
        {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Retour aux articles</a>
    </footer>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
  }

  .post-header {
    margin-bottom: var(--space-xl);
    border-bottom: 0;
  }

  .post-meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-sm);
  }

  .post-title {
    margin-bottom: var(--space-md);
  }

  .post-tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }

  /* Typography for Content */
  .post-content {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(pre) {
    background: var(--color-surface);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    margin: var(--space-md) 0;
    overflow-x: auto;
  }

  .post-content :global(code) {
    font-family: monospace;
    font-size: 0.9em;
  }

  .post-content :global(ul) {
    padding-left: var(--space-md);
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .post-content :global(li) {
    margin-bottom: 0.25rem;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-md);
    color: var(--color-text-tertiary);
    font-style: italic;
    margin: var(--space-md) 0;
  }

  .post-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .back-link:hover {
    opacity: 1;
  }
</style>
