---
import { getEntry, getCollection } from 'astro:content';
import HomeTemplate from '../components/HomeTemplate.astro';

const entry = await getEntry('homepage', 'en');
const articles = await getCollection('blog', ({ data, slug }) => {
  return data.draft !== true && slug.startsWith('en/');
});

// Sort articles by date descending
articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

if (!entry) {
  throw new Error('Homepage entry not found');
}

const { data: content } = entry;
---

<HomeTemplate content={content} lang="en" articles={articles} />
