---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout
  title="Adrien Petitjean - Web developer"
  description="Adrien Petitjean web developer, webdevelop.fr"
  keywords="Adrien Petitjean, web developer, PHP, SQL, nodeJs, JavaScript, AJAX, web"
  lang="en"
>
  <Navigation lang="en" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">ADRIEN PETITJEAN</h1>
        <h2 class="hero-subtitle">Staff Developer</h2>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-content">
        <h3>About me</h3>
        <p>
          👋 My name is Adrien, and I am a Staff Developer at <a
            href="https://www.lightspeedhq.com/"
            target="_blank"
            rel="noopener">Lightspeed</a
          >.
        </p>
        <p>I started my journey in 2008.</p>
        <p>
          Throughout my career, I have had the privilege to work on complex
          technical challenges at world-class companies like <a
            href="https://unity.com/"
            target="_blank"
            rel="noopener">Unity Technologies</a
          > and <a
            href="https://www.shutterstock.com/"
            target="_blank"
            rel="noopener">Shutterstock</a
          >.
        </p>
        <p>
          I enjoy all aspects of web development and I am always driven by
          creating scalable architectures and learning new things.
        </p>
        <p>
          Check out my complete professional experience on <a
            href="https://www.linkedin.com/in/adrien-petitjean-10916255"
            target="_blank"
            rel="noopener">LinkedIn</a
          >.
        </p>
        <p>
          I would be happy to chat with you, so please don't hesitate to <a
            href="#contact">reach out to me</a
          >.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="projects" id="projects">
    <div class="container">
      <h3>My work</h3>
      <p class="projects-intro">
        Here is a list of recent projects I have been involved in and 💛 working
        on during my personal time.
      </p>
      <ul class="projects-list">
        <li>
          My <a
            href="https://medium.com/@adrien.petitjean84"
            target="_blank"
            rel="noopener">Medium posts</a
          >
        </li>
        <li>
          A template to create <a
            href="https://github.com/GreGosPhaTos/typescript-lambda"
            target="_blank"
            rel="noopener">AWS Lambdas with Typescript</a
          >.
        </li>
        <li>
          The website of <a
            href="https://emma-roussel-naturopathe.com/"
            target="_blank"
            rel="noopener">Emma Roussel Naturopath</a
          >.
        </li>
        <li>
          <a
            href="https://github.com/GreGosPhaTos/bigfile"
            target="_blank"
            rel="noopener">Bigfile</a
          >: An executable that identifies large files on your system.
        </li>
        <li>
          <a
            href="https://github.com/GreGosPhaTos/zippy"
            target="_blank"
            rel="noopener">Zippy</a
          >: An archiver made with Electron JS.
        </li>
        <li>
          <a
            href="https://codepen.io/GreGosPhaTos/pen/yLxBdMB"
            target="_blank"
            rel="noopener">Some code pen projects</a
          >
        </li>
        <li>
          And <a
            href="https://github.com/GreGosPhaTos/webdevelop.fr"
            target="_blank"
            rel="noopener">this website</a
          > made with Astro.
        </li>
      </ul>
      <p class="projects-more">
        You can explore all my work on my <a
          href="https://github.com/GreGosPhaTos"
          target="_blank"
          rel="noopener">GitHub account</a
        >. Stay tuned for more exciting projects!
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-content">
        <h3>Contact me</h3>
        <p class="contact-tagline">Ready to reach for the moon together?</p>
        <p class="contact-email">
          Reach out to me at <a href="mailto:adrien.petitjean84@gmail.com"
            >adrien.petitjean84@gmail.com</a
          >
        </p>
        <div class="social-links">
          <a
            href="https://github.com/GreGosPhaTos"
            target="_blank"
            rel="noopener"
            title="GitHub"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/adrien-petitjean-10916255"
            target="_blank"
            rel="noopener"
            title="LinkedIn"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href="https://medium.com/@adrien.petitjean84"
            target="_blank"
            rel="noopener"
            title="Medium"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42S14.2 15.54 14.2 12s1.51-6.42 3.38-6.42S20.96 8.46 20.96 12zm3.04 0c0 3.03-.47 5.48-1.05 5.48S21.9 15.03 21.9 12s.47-5.48 1.05-5.48S24 8.97 24 12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <p>&copy; 2026 Adrien Petitjean - WebDevelop</p>
        <p class="footer-note">Eco-designed website • ~15KB • ~0.01g CO₂</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Variables and base styles are in Layout.astro */

  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-bg) 0%,
      var(--color-surface) 100%
    );
  }

  .hero-content {
    text-align: center;
    animation: fadeInUp 1s ease-out;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 300;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
  }

  /* About Section */
  .about {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }

  .about-content {
    max-width: 700px;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .about-content h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-lg);
    font-weight: 400;
  }

  .about-content p {
    margin-bottom: var(--space-md);
    line-height: 1.8;
  }

  .about-content a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .about-content a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  /* Projects Section */
  .projects {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }

  .projects h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-lg);
    font-weight: 400;
    animation: fadeInUp 1s ease-out 0.3s both;
  }

  .projects-intro {
    margin-bottom: var(--space-lg);
    animation: fadeInUp 1s ease-out 0.4s both;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-lg);
  }

  .projects-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
    animation: fadeInUp 1s ease-out calc(0.5s + var(--i) * 0.1s) both;
  }

  .projects-list li:nth-child(1) {
    --i: 0;
  }
  .projects-list li:nth-child(2) {
    --i: 1;
  }
  .projects-list li:nth-child(3) {
    --i: 2;
  }
  .projects-list li:nth-child(4) {
    --i: 3;
  }
  .projects-list li:nth-child(5) {
    --i: 4;
  }
  .projects-list li:nth-child(6) {
    --i: 5;
  }
  .projects-list li:nth-child(7) {
    --i: 6;
  }

  .projects-list a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .projects-list a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  .projects-more {
    color: var(--color-text-secondary);
    animation: fadeInUp 1s ease-out 1.2s both;
  }

  .projects-more a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .projects-more a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  /* Contact Section */
  .contact {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }

  .contact-content {
    max-width: 600px;
  }

  .contact-content h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: var(--space-md);
    font-weight: 400;
  }

  .contact-tagline {
    font-size: 1.25rem;
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .contact-email {
    margin-bottom: var(--space-xl);
  }

  .contact-email a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base);
  }

  .contact-email a:hover {
    text-decoration-color: var(--color-text-primary);
  }

  .social-links {
    display: flex;
    gap: var(--space-lg);
  }

  .social-links a {
    color: var(--color-text-secondary);
    transition:
      color var(--transition-base),
      transform var(--transition-base);
    display: inline-block;
  }

  .social-links a:hover {
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  /* Footer */
  .footer {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-content p {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }

  .footer-note {
    font-size: 0.75rem !important;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding-top: 4rem;
      min-height: 90vh;
    }

    .footer-content {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
