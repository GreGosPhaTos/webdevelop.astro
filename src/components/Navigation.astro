---
interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="logo">WebDevelop</a>

    <div class="nav-right">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Theme">
        <svg
          class="sun-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="moon-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <div class="lang-switcher">
        <a href="/" class:list={['lang-link', { active: lang === 'fr' }]}>FR</a>
        <span class="separator">/</span>
        <a href="/en" class:list={['lang-link', { active: lang === 'en' }]}
          >EN</a
        >
      </div>
    </div>
  </div>
</nav>

<script>
  import { initScrollEffects } from '../utils/effects';
  initScrollEffects();

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const currentTheme = document.documentElement.dataset.theme;
      if (currentTheme === 'light') {
        delete document.documentElement.dataset.theme;
      } else {
        document.documentElement.dataset.theme = 'light';
      }
    });
  }
</script>

<style>
  .theme-toggle {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: var(--space-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color var(--transition-base),
      transform var(--transition-base);
    opacity: 0.6;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    opacity: 1;
    transform: scale(1.1);
  }

  .sun-icon {
    display: none;
  }
  .moon-icon {
    display: block;
  }

  :root[data-theme='light'] .sun-icon {
    display: none;
  }
  :root[data-theme='light'] .moon-icon {
    display: block;
  }

  /* When in light mode, the button should show the moon icon to switch back to dark */
  /* If we want it to act as a dark/light toggle strictly: */
  :root[data-theme='light'] .theme-toggle .sun-icon {
    display: block;
  }
  :root[data-theme='light'] .theme-toggle .moon-icon {
    display: none;
  }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: var(--space-md) 0;
    border-bottom: 1px solid transparent; /* Prevent jump/glitch on transition */
    transition:
      background-color var(--transition-base),
      padding var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .nav.scrolled {
    background-color: var(--color-surface-glass); /* Glassmorphic background */
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  }

  /* Scroll Transition for Logo */
  .nav.scrolled .logo {
    color: var(--color-accent-secondary); /* Teal accent on scroll */
    text-shadow: 0 0 20px var(--color-accent-glow);
  }

  .nav-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--color-text-primary);
    transition:
      color var(--transition-base),
      text-shadow var(--transition-base);
  }

  .lang-switcher {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    transition: color var(--transition-base);
  }

  /* Scroll Transition for Links */
  .nav.scrolled .lang-switcher {
    color: var(--color-text-secondary); /* Slightly brighter on dark glass */
  }

  .lang-link {
    transition: color var(--transition-base);
  }

  .lang-link.active {
    color: var(--color-text-primary);
  }

  .nav.scrolled .lang-link.active {
    color: var(
      --color-accent
    ); /* Active language gets primary accent on scroll */
  }

  .separator {
    margin: 0 0.25rem;
    opacity: 0.2;
  }

  @media (max-width: 768px) {
    .nav {
      padding: var(--space-sm) 0;
    }
  }
</style>
