---
interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="logo">WebDevelop</a>

    <div class="nav-right">
      <div class="lang-switcher">
        <a href="/" class:list={['lang-link', { active: lang === 'fr' }]}>FR</a>
        <span class="separator">/</span>
        <a href="/en" class:list={['lang-link', { active: lang === 'en' }]}
          >EN</a
        >
      </div>
    </div>
  </div>
</nav>

<script>
  import { initScrollEffects } from '../utils/effects';
  initScrollEffects();
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: var(--space-md) 0;
    border-bottom: 1px solid transparent; /* Prevent jump/glitch on transition */
    transition:
      background-color var(--transition-base),
      padding var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .nav.scrolled {
    background-color: var(--color-surface-glass); /* Glassmorphic background */
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  }

  /* Scroll Transition for Logo */
  .nav.scrolled .logo {
    color: var(--color-accent-secondary); /* Teal accent on scroll */
    text-shadow: 0 0 20px var(--color-accent-glow);
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--color-text-primary);
    transition:
      color var(--transition-base),
      text-shadow var(--transition-base);
  }

  .lang-switcher {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    transition: color var(--transition-base);
  }

  /* Scroll Transition for Links */
  .nav.scrolled .lang-switcher {
    color: var(--color-text-secondary); /* Slightly brighter on dark glass */
  }

  .lang-link {
    transition: color var(--transition-base);
  }

  .lang-link.active {
    color: var(--color-text-primary);
  }

  .nav.scrolled .lang-link.active {
    color: var(
      --color-accent
    ); /* Active language gets primary accent on scroll */
  }

  .separator {
    margin: 0 0.25rem;
    opacity: 0.2;
  }

  @media (max-width: 768px) {
    .nav {
      padding: var(--space-sm) 0;
    }
  }
</style>
