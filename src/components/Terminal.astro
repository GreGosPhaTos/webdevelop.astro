---

---

<div id="terminal-overlay" class="terminal-overlay hidden">
  <div class="terminal-window">
    <div class="terminal-header">
      <div class="controls">
        <span class="control close"></span>
        <span class="control minimize"></span>
        <span class="control maximize"></span>
      </div>
      <div class="title">adrien@webdevelop: ~</div>
    </div>
    <div class="terminal-body" id="terminal-body">
      <div class="output">
        <span class="prompt">➜</span>
        <span class="command">welcome</span><br />
        Welcome to the backbone. Type 'help' to see available commands.
      </div>
      <div class="input-line">
        <span class="prompt">➜</span>
        <input
          type="text"
          id="terminal-input"
          autocomplete="off"
          spellcheck="false"
          autofocus
        />
      </div>
    </div>
  </div>
</div>

<button
  id="terminal-trigger"
  class="terminal-trigger"
  aria-label="Open Terminal"
>
  &gt;&#95;
</button>

<script>
  const overlay = document.getElementById('terminal-overlay');
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const body = document.getElementById('terminal-body');
  const trigger = document.getElementById('terminal-trigger');

  if (overlay && input && body && trigger) {
    // Toggle Terminal
    function toggleTerminal() {
      overlay!.classList.toggle('hidden');
      if (!overlay!.classList.contains('hidden')) {
        input!.focus();
      }
    }

    // Keyboard shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        toggleTerminal();
      }
      // Close on Escape
      if (e.key === 'Escape' && !overlay!.classList.contains('hidden')) {
        toggleTerminal();
      }
    });

    trigger.addEventListener('click', toggleTerminal);

    // Close on click outside
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        toggleTerminal();
      }
    });

    // Command Handling
    const commands = {
      help: 'Available commands: about, projects, contact, theme [neon|cyber|mono|light|default], clear, exit',
      about:
        'Staff Software Engineer. 15+ years. Builder of resilient systems.',
      projects:
        'Check out the "Selected Work" section or try `ls projects` (just kidding, go scroll).',
      contact: 'Email me at adrien@webdevelop.fr',
      clear: 'clear',
      exit: 'exit',
      sudo: 'User is not in the sudoers file. This incident will be reported.',
      ls: 'blog/  projects/  about.md  secret.txt',
      'cat secret.txt': 'You found the easter egg! 🥚',
    };

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = input.value.trim().toLowerCase();

        // Add command to history
        const historyLine = document.createElement('div');
        historyLine.innerHTML = `<span class="prompt">➜</span> ${input.value}`;
        body?.insertBefore(historyLine, document.querySelector('.input-line'));

        // Process command
        let response = '';

        if (commands[cmd as keyof typeof commands]) {
          response = commands[cmd as keyof typeof commands];
        } else if (cmd.startsWith('theme ')) {
          const theme = cmd.split(' ')[1];
          if (['neon', 'cyber', 'mono', 'light'].includes(theme)) {
            document.documentElement.dataset.theme = theme;
            response = `Theme set to ${theme.charAt(0).toUpperCase() + theme.slice(1)}.`;
          } else if (theme === 'default') {
            delete document.documentElement.dataset.theme;
            response = 'Theme restored to default.';
          } else {
            response = 'Unknown theme. Try: neon, cyber, mono, light, default';
          }
        } else if (cmd === 'clear') {
          // Handled below
        } else if (cmd === 'exit') {
          toggleTerminal();
        } else {
          response = `command not found: ${cmd}`;
        }

        if (cmd !== 'clear' && cmd !== 'exit') {
          const responseLine = document.createElement('div');
          responseLine.className = 'response';
          responseLine.textContent = response;
          body.insertBefore(
            responseLine,
            document.querySelector('.input-line'),
          );
        } else if (cmd === 'clear') {
          const outputs = body.querySelectorAll('div:not(.input-line)');
          outputs.forEach((el) => el.remove());
        }

        input.value = '';
        body.scrollTop = body.scrollHeight;
      }
    });
  }
</script>

<style>
  .terminal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.2s;
  }

  .terminal-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .terminal-window {
    width: 600px;
    height: 400px;
    background: var(--color-surface);
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    font-family: 'Fira Code', monospace;
    overflow: hidden;
  }

  .terminal-header {
    background: var(--color-surface-hover);
    padding: 10px 15px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .close {
    background: #ff5f56;
  }
  .minimize {
    background: #ffbd2e;
  }
  .maximize {
    background: #27c93f;
  }

  .title {
    margin: 0 auto;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    opacity: 0.8;
  }

  .terminal-body {
    flex: 1;
    padding: 20px;
    color: var(--color-text-primary);
    font-size: 0.9rem;
    overflow-y: auto;
  }

  .prompt {
    color: var(--color-accent-secondary);
    margin-right: 8px;
    font-weight: bold;
  }

  .input-line {
    display: flex;
    align-items: center;
    margin-top: 5px;
  }

  input {
    background: transparent;
    border: none;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    flex: 1;
    outline: none;
  }

  .response {
    color: #a1a1aa;
    margin-bottom: 15px;
    margin-left: 20px;
    line-height: 1.5;
  }

  .terminal-trigger {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-accent);
    font-family: monospace;
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
    z-index: 1000;
  }

  .terminal-trigger:hover {
    transform: scale(1.1);
    border-color: var(--color-accent);
  }
</style>
